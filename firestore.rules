rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in Zubriy user can access only documents under their Firebase Auth UID.
    match /users/{userId}/sets/{setId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/meta/{metaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Shared sets: any signed-in user can read; only the owner can create, change or remove.
    match /shared/{shareId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
